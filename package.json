{
  "name": "hivek",
  "version": "1.0.0",
  "private": true,
  "type": "commonjs",
  "packageManager": "pnpm@10.26.1",
  "scripts": {
    "dev": "turbo dev --ui tui",
    "build": "turbo build",
    "install:ai": "cd apps/server-ai && pip install -r requirements.txt",
    "install:agentic": "cd apps/agentic-system && uv venv --python 3.12 && uv pip install -e \".[dev]\"",
    "test:agentic": "cd apps/agentic-system && uv run pytest -q",
    "d2": "d2 --watch docs/d2/*.d2 docs/d2/*.png"
  },
  "devDependencies": {
    "concurrently": "^9.0.0",
    "turbo": "^2.9.14"
  }
}
