{
  "$schema": "https://dprint.dev/schemas/v0.json",
  "incremental": true,
  "typescript": {
    "lineWidth": 100,
    "indentWidth": 2,
    "semiColons": "always",
    "quoteStyle": "alwaysSingle"
  },
  "json": {
    "indentWidth": 2
  },
  "markdown": {
    "lineWidth": 100
  },
  "excludes": [
    "**/node_modules",
    "**/.next",
    "**/dist",
    "**/coverage",
    "**/.venv",
    "**/uv.lock",
    "**/pnpm-lock.yaml",
    "**/package-lock.json"
  ],
  "plugins": [
    "https://plugins.dprint.dev/typescript-0.93.4.wasm",
    "https://plugins.dprint.dev/json-0.19.4.wasm",
    "https://plugins.dprint.dev/markdown-0.17.8.wasm"
  ]
}
