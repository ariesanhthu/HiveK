APP_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# HiveK backend. Keep the API key server-side only; do not expose it as NEXT_PUBLIC_*.
HIVEK_BACKEND_BASE_URL=https://hivek-main-backend-54ef5f252bc1.herokuapp.com
HIVEK_BACKEND_API_KEY=

# Browser SDK. Empty base URL means same-origin mock Next.js routes.
NEXT_PUBLIC_AGENTIC_API_BASE_URL=
NEXT_PUBLIC_AGENTIC_API_BASE_PATH=/api/ai

# Server-side route cache. Leave empty to use in-memory mock cache.
REDIS_URL=
AI_CACHE_TTL_SECONDS=300

# Future real agent provider config. Never expose provider keys to browser env.
AI_AGENT_PROVIDER=mock
AI_LOG_AGENT_TRACE=false
GEMINI_API_KEYS=
GEMINI_MODEL_FAST=gemini-2.5-flash
GEMINI_MODEL_STRATEGY=gemini-2.5-pro
GEMINI_MODEL_VALIDATOR=gemini-2.5-flash
GEMINI_MAX_RETRIES=3
GEMINI_TIMEOUT_SECONDS=60

VECTOR_SEARCH_PROVIDER=mongodb
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=hivek
BRAND_MEMORY_VECTOR_INDEX=brand_memory_vector_index
KOL_PROFILE_VECTOR_INDEX=kol_profile_vector_index

# YouTube Data API v3 - used for syncing real KOL avatar + subscriber count.
# Get your key at: https://console.cloud.google.com/apis/credentials
# Enable "YouTube Data API v3" in the API Library.
YOUTUBE_API_KEY=
