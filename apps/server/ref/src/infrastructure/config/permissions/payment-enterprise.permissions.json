[
  {
    "_id": "payment:ReadOwnWallet",
    "name": "Read Own Wallet",
    "service": "payment",
    "can": true,
    "action": "read",
    "subject": "Wallet",
    "domain": "ENTERPRISE",
    "fields": ["*"],
    "conditions": {
      "userId": "${user.id}",
      "tenantId": "${user.tenantId}",
      "belong": { "$in": ["Enterprise", "Subenterprise", "EnterpriseUser"] }
    }
  },
