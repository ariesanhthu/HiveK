{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "deleteOutDir": true,
    "assets": [
      {
        "include": "infrastructure/rabbitmq/**/*.json",
        "outDir": "dist/src"
      },
      {
        "include": "config/**/*.json",
        "outDir": "dist/src"
      },
      {
        "include": "infrastructure/mailer/templates/**/*.hbs",
        "outDir": "dist/src"
      }
    ]
  }
}
